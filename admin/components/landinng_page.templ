package components

templ LandingPage() {

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>App Landing Page</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/static//css/home_style.css">
    <link rel="icon" href="/static/img/Ben_Logo.png" type="image/x-icon">
</head>
<body>
  <nav class="navbar">
    <a href="#" class="logo img">
        <img src="/static/img/logo.png"  alt="Ben Logo">
    </a>
  </nav>

  <div class="hero-section">
        <div class="background-shapes">
            <div class="purple-shape"></div>
            <div class="pink-shape"></div>
        </div>

        <div class="text-content">
            <h1 style="color: var(--primary-blue); padding-top: 120px;">Save Smarter. Earn More.</h1>
            <h3>Turn your savings into real rewards with Gold Savings.</h3>
            <p style="color: var(--primary-blue); background-color: white;"> With every deposit, you grow your money and earn tokens you can convert to airtime — or even cash (coming soon). It’s savings with benefits.
               Start today. It’s simple, secure, and built for your goals.Your money should work as hard as you do.</p>
            <div class="cta-buttons">
                <a href="#" class="download-btn">
                    <i class="fab fa-apple"></i>
                    <span>Download for iOS</span>
                </a>
                <a href="#" class="download-btn">
                    <i class="fab fa-google-play"></i>
                    <span>Download for Android</span>
                </a>
            </div>
        </div>

                <div class="image-content">
            <img src="/static/img/phone_4-removebg-preview.png" alt="Phone Mockup"  style="width:350px; height: 680px; object-fit: cover; background:transparent;">
        </div>
    </div>

    <div class="features-section">
        <div class="features-header">
            <h2>Powerful Features Built to Help You Save Better</h2>
            <p>
               From simple goal-setting to real rewards, every feature of Gold Savings is designed with your financial growth in mind.
            </p>
        </div>
        <div class="features-grid-container">
            <div class="circle"></div>
            <div class="features-grid">
                <div class="feature-card">
                    <h3>💼 Smart Savings Plans</h3>
                    <p>
                        Whether you want to lock in savings or set goals with flexible timelines, we’ve got plans that grow with you — plus interest.
                    </p>
                </div>
                <div class="feature-card">
                    <h3>🎨 Sleek, User-Friendly Design</h3>
                    <p>
                        Clean, intuitive, and easy to navigate — Gold Savings is designed for simplicity, clarity, and confidence at every step.
                    </p>
                </div>
                <div class="feature-card">
                    <h3>🔐 Bank-Level Security</h3>
                    <p>
                       Your data and funds are protected with encrypted systems, secure logins, and real-time monitoring to keep you safe.
                    </p>
                </div>
            </div>
            <div class="circle"></div>
        </div>
    </div>

    <div class="how-it-works-section">
          <div class="mockup-container girl-bg">
        <div class="mockup-content">
            <h2 style="color: var(--primary-blue)">Get Reward Why You Save!</h2>
            <p  style="color: var(--primary-blue)">End and Convert TOKENS from your savings, referrals and completed cycles!</p>
            <div class="button-group">
                <a href="#" id="signup-button" class="button">Sign Up</a>
                <a href="#" id="login-button" class="button">Login</a>
            </div>
        </div>
    </div>
        <div class="steps-container">
            <h2>Start Saving in 3 Easy Steps</h2>
            <div class="step">
                <div class="circle"></div>
                <div class="step-content">
                    <h3>📲 Download the Mobile App</h3>
                    <p>Get the Gold Savings app on your phone. It's free and available for both Android and iOS users.</p>
                </div>
            </div>
            <div class="step">
                <div class="circle"></div>
                <div class="step-content">
                    <h3>👤 Create Your Account</h3>
                    <p>Sign up in minutes using your email. No long forms or hidden fees — just a smooth, secure onboarding.</p>
                </div>
            </div>
            <div class="step">
                <div class="circle"></div>
                <div class="step-content">
                    <h3>💰 Start Saving & Earning</h3>
                    <p>Pick a savings plan, make your first deposit, and start earning tokens instantly. Watch your savings grow!</p>
                </div>
            </div>
            <div class="download-buttons">
                <a href="#" class="download-btn app-store-btn">
                    Available on APP STORE
                </a>
                <a href="#" class="download-btn google-play-btn">
                    Available on GOOGLE PLAY
                </a>
            </div>
        </div>
    </div>
    <div class="faq-section">
        <h2>Frequently Asked Questions</h2>
            <div class="faq-grid">
            <div class="faq-item">
                <h3>Is there a minimum amount required to save?</h3>
                <p>No. You can start saving with any amount that works for you. There’s no minimum for savings on Gold Savings.</p>
            </div>
            <div class="faq-item">
                <h3>What is the minimum amount required to invest?</h3>
                <p>The minimum investment amount is ₦5,000. This ensures your funds are eligible to earn interest and rewards.</p>
            </div>
            <div class="faq-item">
                <h3>Do savings and investments both earn interest?</h3>
                <p>Yes. Whether you’re saving casually or investing more intentionally, your funds can earn interest based on your plan and duration.</p>
            </div>
            <div class="faq-item">
                <h3>Can I withdraw my savings or investment anytime?</h3>
                <p>Withdrawals are allowed, but early withdrawals may reduce your interest or token rewards. The system will notify you of any impact before confirming.</p>
            </div>
            <div class="faq-item">
                <h3>How can I monitor my savings and investment progress?</h3>
                <p>Your dashboard gives you a full overview of your savings balance, investment growth, interest earned, and tokens collected.</p>
            </div>
            </div>
    </div>
    <footer class="footer">
        <p>copyright@2025 Gold Savings</p>
    </footer>
  </body>

</html>
}